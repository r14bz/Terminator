{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npm run test:ip && npm run test:optical && npm run test:ping && npm run test:history && npm run test:history-wiring && npm run test:placement && npm run test:zoom && npm run test:internet-map && npm run test:internet-access && npm run test:ports && npm run test:ipalloc",
    "test:ports": "node --import ./scripts/ts-resolve.mjs scripts/verify-ports.mjs",
    "test:ipalloc": "node --import ./scripts/ts-resolve.mjs scripts/verify-ipalloc.mjs",
    "test:ip": "node scripts/verify-ipUtils.mjs",
    "test:optical": "node scripts/verify-optical.mjs",
    "test:ping": "node --import ./scripts/ts-resolve.mjs scripts/verify-ping.mjs",
    "test:history": "node --import ./scripts/ts-resolve.mjs scripts/verify-history.mjs",
    "test:history-wiring": "node --import ./scripts/ts-resolve.mjs scripts/verify-history-wiring.mjs",
    "test:placement": "node --import ./scripts/ts-resolve.mjs scripts/verify-placement.mjs",
    "test:mutation": "bash scripts/mutate-placement.sh && bash scripts/mutate-history.sh && bash scripts/mutate-ports.sh && bash scripts/mutate-ipalloc.sh",
    "test:mutation:placement": "bash scripts/mutate-placement.sh",
    "test:mutation:history": "bash scripts/mutate-history.sh",
    "test:mutation:ports": "bash scripts/mutate-ports.sh",
    "test:mutation:ipalloc": "bash scripts/mutate-ipalloc.sh",
    "test:zoom": "node --import ./scripts/ts-resolve.mjs scripts/verify-zoom.mjs",
    "test:internet-map": "node --import ./scripts/ts-resolve.mjs scripts/verify-internet-map.mjs",
    "test:internet-access": "node --import ./scripts/ts-resolve.mjs scripts/verify-internet-access.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
