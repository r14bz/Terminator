# AI Provider Configuration: "openrouter", "gemini", or "opencode"
AI_PROVIDER="openrouter"

# OpenRouter (Supports DeepSeek V3, Llama 3.3, Free Tier Models, etc.)
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="deepseek/deepseek-chat"

# Google Gemini (Default built-in AI)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenCode Zen (Alternative provider)
OPENCODE_API_KEY="your-opencode-api-key"
OPENCODE_BASE_URL="https://opencode.ai/zen/v1"
OPENCODE_MODEL="big-pickle"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CATATAN VERCEL: env var di atas TIDAK ikut ter-deploy dari file .env.
# Isi di Vercel > Project > Settings > Environment Variables
# (minimal GEMINI_API_KEY, atau OPENROUTER_API_KEY), lalu Redeploy.
